{
  "name": "msync",
  "version": "0.2.0",
  "description": "Cross-platform music collection sync for Spotify, Apple Music and NetEase",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "author": "MSync contributors",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run typecheck && npm run build:main && vite build",
    "start": "node --env-file-if-exists=.env dist/main/index.js",
    "test": "node scripts/test.mjs",
    "test:ui": "playwright test",
    "demo": "tsx src/cli.ts demo",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "4.41.1",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sql.js": "1.15.2",
    "zod": "3.25.76",
    "open": "11.0.4",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "@types/proper-lockfile": "4.1.4",
    "tar": "7.5.23"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.2"
  }
}
